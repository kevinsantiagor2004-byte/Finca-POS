# ============================================================
# .env.example — Plantilla de variables de entorno
# ============================================================
# ⚠️  INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena los valores reales en .env
#   3. NUNCA subas el archivo .env al repositorio Git
#      (ya está en .gitignore)
# ============================================================

# ── Entorno de la aplicación ────────────────────────────────
# Valores válidos: Development | QA | Production
APP_ENV=Development

# ── Base de datos PostgreSQL ────────────────────────────────
# Contraseña del usuario 'postgres'
POSTGRES_PASSWORD=cambia_esta_contraseña_123!

# ── JWT — Clave secreta ─────────────────────────────────────
# Debe tener MÍNIMO 32 caracteres. Genera una con:
#   openssl rand -base64 48
JWT_KEY=cambia_esta_clave_secreta_jwt_min32chars!!

# ── Seeding — Usuario Admin inicial ────────────────────────
# En Production pon Enabled=false una vez creado el admin real
SEEDING_ENABLED=true
ADMIN_EMAIL=admin@finca.com
ADMIN_PASSWORD=cambia_esta_contraseña_admin!

# ── pgAdmin (opcional, solo con --profile tools) ────────────
PGADMIN_PASSWORD=Admin@pgAdmin2024!
