{
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Port=5432;Database=proyecto_finca_pos_qa;Username=postgres;Password=${POSTGRES_PASSWORD};Include Error Detail=false"
  },
  "Jwt": {
    "Key": "${JWT_KEY}",
    "Issuer": "ProyectoFinca.API.QA",
    "Audience": "ProyectoFinca.Clients",
    "ExpiresInHours": 4
  },
  "POS": {
    "PorcentajeImpuestoDefault": 0.19,
    "PorcentajeIva": 0.19,
    "PorcentajeImpoconsumo": 0.08
  },
  "Dian": {
    "Ambiente": "QA_Sandbox",
    "Proveedor": "Mock",
    "NitEmisor": "${DIAN_NIT:-901234567-1}",
    "RazonSocial": "${DIAN_RAZON_SOCIAL:-Finca Turística El Paraíso S.A.S.}",
    "Prefijo": "SETP",
    "NumeroResolucion": "18764000001",
    "TestSetId": "${DIAN_TEST_SET_ID:-c2a9a7b1-4f8e-42c1-b0f3-93d8b5f3a021}",
    "ClaveTecnica": "${DIAN_CLAVE_TECNICA:-fc8eac422eba16e122d5aa92a14ebd8c0ec31984}"
  },
  "Seeding": {
    "Enabled": true,
    "AdminNombreCompleto": "Administrador QA",
    "AdminEmail": "${ADMIN_EMAIL}",
    "AdminPassword": "${ADMIN_PASSWORD}",
    "AdminTelefono": null
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://qa.finca.example.com"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
